# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=3000

# Random 32+ byte secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=

DB_PATH=./data/lumio.sqlite
UPLOAD_DIR=./data/uploads

# Where the one-time first-run setup token gets written. Defaults to
# setup-token.txt next to DB_PATH if unset - only needed if you want it
# somewhere else.
SETUP_TOKEN_PATH=

# Upload size limit in megabytes
MAX_UPLOAD_MB=25

# Failed logins allowed before an account is temporarily locked
LOGIN_RATE_LIMIT_MAX=5
LOGIN_LOCKOUT_MINUTES=15

# How long a Garmin pairing code stays valid before it must be re-generated
PAIRING_CODE_TTL_MINUTES=10

# How long a deleted file sits in trash before it's purged for good, and how
# long a login session stays valid before it must be re-established
TRASH_RETENTION_DAYS=30
SESSION_MAX_AGE_DAYS=30

# WebAuthn/passkey settings. RP ID must be the bare domain (no scheme/port)
# the app is served from; origin is the full URL the browser sees, scheme
# included. Both default to localhost/http://localhost:5173 outside
# production and MUST be set explicitly in production - there's no safe
# default for either once NODE_ENV=production.
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=Lumio
WEBAUTHN_ORIGIN=

# Reserved for a future Duo Security integration - unused by the app today.
DUO_INTEGRATION_KEY=
DUO_SECRET_KEY=
DUO_API_HOSTNAME=

# Comma-separated subnets Express trusts as reverse-proxy hops (accepts
# "loopback", "linklocal", "uniquelocal", or CIDR ranges). Only nginx talks
# to this process by default, so "loopback" alone is correct for that.
# Add another subnet only if a further hop (e.g. a domain-fronting proxy)
# sits in front of nginx - otherwise every request behind it would be
# attributed to that hop's own address instead of the real client for
# rate-limiting, lockout, and fail2ban.
TRUSTED_PROXY_SUBNETS=loopback
