# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=3000

# Random 32+ byte secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=

DB_PATH=./data/lumio.sqlite
UPLOAD_DIR=./data/uploads

# Upload size limit in megabytes
MAX_UPLOAD_MB=25

# Failed logins allowed before an account is temporarily locked
LOGIN_RATE_LIMIT_MAX=5
LOGIN_LOCKOUT_MINUTES=15

# How long a Garmin pairing code stays valid before it must be re-generated
PAIRING_CODE_TTL_MINUTES=10
